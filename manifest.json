{
  "manifest_version": 3,
  "name": "Yap Video URL Copier",
  "version": "1.2",
  "description": "Добавляет кнопки копирования ссылки и скачивания видео в плеер ЯП",
  "permissions": ["clipboardWrite", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.yap.ru/*",
    "*://*.yapfiles.ru/*",
    "*://api.yapfiles.ru/*",
    "*://*.yapfiles.com/*",
    "*://api-ru.yapfiles.com/*"
  ],
  "content_scripts": [
  {
    "matches": [
      "*://*.yap.ru/*",
      "*://*.yapfiles.ru/*",
      "*://api.yapfiles.ru/*",
      "*://*.yapfiles.com/*",
      "*://api-ru.yapfiles.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_end",
    "all_frames": true
  }
]
}
